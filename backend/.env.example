# Application
APP_NAME=ApplyWise API
APP_VERSION=0.1.0
APP_ENV=development
DEBUG=true

# Server
HOST=0.0.0.0
PORT=8000

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000

# OpenAI (future)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Hugging Face Inference API (LLM analysis — not used for RAG embeddings)
# HF_TOKEN=
# HUGGINGFACE_INFERENCE_MODEL=meta-llama/Llama-3.1-8B-Instruct

# ChromaDB / RAG
CHROMA_PERSIST_DIRECTORY=chroma_data
STATIC_COLLECTION_NAME=static_knowledge
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
RETRIEVAL_TOP_K=5
